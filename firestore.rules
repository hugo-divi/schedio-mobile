rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 🏠 Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 👤 User Profiles
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, delete: if isOwner(userId);

      // 🛡️ Premium entitlement is owned by RevenueCat, never by the client.
      // Reject any update that touches `isPrime` so a user cannot grant
      // themselves Prime by writing a single field.
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPrime']);

      // Server-only usage counters (e.g. daily AI quota in functions/index.js).
      // The Admin SDK bypasses rules entirely, so the client should never be
      // able to touch this — otherwise anyone can reset their own quota.
      match /meta/{docId} {
        allow read, write: if false;
      }

      // Allow nested collections (notes, resources, etc.)
      match /{allPaths=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // 📚 Subjects
    match /subjects/{subjectId} {
      // Split rather than `read, write: if isOwner(resource.data.userId) ||
      // isOwner(request.resource.data.userId)` — that OR let anyone update
      // someone else's doc as long as their write also set `userId` to their
      // own uid, since the second clause never checked who the doc already
      // belonged to. create only needs the new doc to claim you as owner;
      // update/delete need the *existing* doc to already be yours.
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId);
    }

    // 📝 Exams
    match /exams/{examId} {
      // Split rather than `read, write: if isOwner(resource.data.userId) ||
      // isOwner(request.resource.data.userId)` — that OR let anyone update
      // someone else's doc as long as their write also set `userId` to their
      // own uid, since the second clause never checked who the doc already
      // belonged to. create only needs the new doc to claim you as owner;
      // update/delete need the *existing* doc to already be yours.
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId);
    }

    // 🔥 Streaks
    match /streaks/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ⏳ Sessions
    match /sessions/{sessionId} {
      // Split rather than `read, write: if isOwner(resource.data.userId) ||
      // isOwner(request.resource.data.userId)` — that OR let anyone update
      // someone else's doc as long as their write also set `userId` to their
      // own uid, since the second clause never checked who the doc already
      // belonged to. create only needs the new doc to claim you as owner;
      // update/delete need the *existing* doc to already be yours.
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId);
    }

    // 📝 Beta signups (landing en schedio.es)
    // Solo-crear, sin lectura desde el cliente: la web escribe altas, nadie
    // puede leer la lista salvo desde la consola de Firebase (que usa el
    // Admin SDK y salta las reglas). Sin isOwner porque quien rellena el
    // formulario no tiene cuenta ni sesión todavía.
    match /betaSignups/{docId} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['email', 'curso', 'android', 'dolor', 'creado'])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 5
        && request.resource.data.email.size() < 200
        && request.resource.data.email.matches('^[^@]+@[^@]+[.][^@]+$')
        && request.resource.data.curso in ['ESO', 'Bachillerato', 'Universidad', 'Otro']
        && request.resource.data.android is bool
        && request.resource.data.dolor is string
        && request.resource.data.dolor.size() < 1000;
      allow read, update, delete: if false;
    }
  }
}

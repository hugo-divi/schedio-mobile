rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 🏠 Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 👤 User Profiles
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, delete: if isOwner(userId);

      // 🛡️ Premium entitlement is owned by RevenueCat, never by the client.
      // Reject any update that touches `isPrime` so a user cannot grant
      // themselves Prime by writing a single field.
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPrime']);

      // Allow nested collections (notes, resources, etc.)
      match /{allPaths=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // 📚 Subjects
    match /subjects/{subjectId} {
      allow read, write: if isOwner(resource.data.userId) || isOwner(request.resource.data.userId);
    }

    // 📝 Exams
    match /exams/{examId} {
      allow read, write: if isOwner(resource.data.userId) || isOwner(request.resource.data.userId);
    }

    // 🔥 Streaks
    match /streaks/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ⏳ Sessions
    match /sessions/{sessionId} {
      allow read, write: if isOwner(resource.data.userId) || isOwner(request.resource.data.userId);
    }
  }
}

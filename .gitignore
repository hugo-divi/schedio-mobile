# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*
*.bak
doctor_*.txt
expo_logs.txt
*_backup/

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# firebase CLI deploy cache
.firebase/

# service account / admin credentials
serviceAccountKey.json
*-firebase-adminsdk-*.json
functions/.runtimeconfig.json

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Gradle output from the local Expo modules. The rule above is anchored to the
# project root, so it never reached the android/ folder that lives inside
# modules/ — this is build output (merged manifests, compiled classes,
# incremental caches keyed to one machine's paths) that would otherwise be
# uploaded with every EAS build.
modules/*/android/build/
modules/*/android/.gradle/

# internal dev notes (not for public repo)
task.md
CLAUDE.md
AGENTS.md

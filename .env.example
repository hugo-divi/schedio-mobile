# Copia este archivo a .env.local y completa los valores reales.
# .env.local nunca se sube a git (ver .gitignore).
#
# Nota: Expo incluye cualquier variable EXPO_PUBLIC_* en el bundle del
# cliente. No es un almacén seguro — nunca pongas aquí una clave que no
# puedas permitirte exponer públicamente.

# Firebase (Auth, Firestore, Storage) — obtener en Firebase Console > Project settings
EXPO_PUBLIC__FIREBASE_API_KEY=
EXPO_PUBLIC__FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC__FIREBASE_PROJECT_ID=
EXPO_PUBLIC__FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC__FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC__FIREBASE_APP_ID=

# Google Gemini: NO va aquí. El cliente llama a la Cloud Function `aiProxy`
# (functions/index.js), que guarda la key como secreto de Firebase Functions
# (`firebase functions:secrets:set GEMINI_API_KEY`) — nunca viaja en el
# bundle de la app.

# Google Sign-In (nativo) — Web Client ID que Firebase crea automáticamente al
# activar Google en Authentication > Sign-in method. Se ve en Google Cloud
# Console > APIs & Services > Credentials, como "Web client (auto created by
# Google Service)". NO es el Android Client ID.
EXPO_PUBLIC__GOOGLE_WEB_CLIENT_ID=

# RevenueCat (compras Schedio Prime) — obtener en RevenueCat dashboard
EXPO_PUBLIC__REVENUECAT_APPLE_KEY=
EXPO_PUBLIC__REVENUECAT_GOOGLE_KEY=
